// main: the moonforge CLI. Native-only by construction — the filesystem lives
// here and nowhere else, so src/core stays wasm-clean.
import {
  "NaIWaniubi/moonforge/src/core",
  "NaIWaniubi/moonforge/src/peinfo",
  "NaIWaniubi/moonforge/src/corpus",
  "NaIWaniubi/moonforge/src/bundle",
  "NaIWaniubi/moonforge/src/wasmcheck",
  "NaIWaniubi/moonforge/src/diff",
  "NaIWaniubi/moonforge/src/policy",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
  "moonbitlang/core/env",
}

pkgtype(kind: "executable")

warnings = "-6-9-79-25-27"
