// web: wasm entry for the browser workbench. Reads "input.bin" through the
// host-provided fs glue and prints a single JSON object on stdout.
import {
  "NaIWaniubi/moonforge/src/core",
  "NaIWaniubi/moonforge/src/xref",
  "NaIWaniubi/moonforge/src/peinfo",
  "NaIWaniubi/moonforge/src/corpus",
  "NaIWaniubi/moonforge/src/bundle",
  "NaIWaniubi/moonforge/src/wasmcheck",
  "NaIWaniubi/moonforge/src/evidence",
  "NaIWaniubi/moonforge/src/diff",
  "NaIWaniubi/moonforge/src/policy",
  "NaIWaniubi/moonbin/src/pe",
  "NaIWaniubi/moonbin/src/elf",
  "NaIWaniubi/moonbin/src/macho",
  "Han-Wentao/moonplist",
  "clbbbb/moonbit-wasm-inspect" @wasm_inspect,
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
}

pkgtype(kind: "executable")

warnings = "-6-9-79-25-27"
